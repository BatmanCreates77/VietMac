<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vietmac.price-update</string>

    <!-- Points at a dedicated clone used only by this job, deliberately
         outside ~/Documents: that folder is macOS privacy-protected (TCC),
         and a launchd-spawned bash has no permission to read it — every
         scheduled run from ~/Documents failed with "Operation not
         permitted" (47/47, Sept 19 - Oct 1 2026). -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/gaurav/vietmac-automation/macbook_scraper/auto-update-prices.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <!-- Run every 6 hours: 00:00, 06:00, 12:00, 18:00 -->
        <dict>
            <key>Hour</key>
            <integer>0</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>12</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>18</integer>
            <key>Minute</key>
            <integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/gaurav/vietmac-automation/macbook_scraper/logs/launchd-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/gaurav/vietmac-automation/macbook_scraper/logs/launchd-stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/gaurav/vietmac-automation/macbook_scraper</string>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <!-- miniforge bin listed first: update_prices.py's dependencies
             (playwright, seleniumbase, beautifulsoup4, requests, pytest)
             are installed there, NOT in the bare system python3. launchd
             does not inherit the interactive shell's PATH/profile, so
             this has to be explicit or `command -v python3` in
             auto-update-prices.sh silently resolves to the wrong,
             dependency-less interpreter. -->
        <string>/opt/homebrew/Caskroom/miniforge/base/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
